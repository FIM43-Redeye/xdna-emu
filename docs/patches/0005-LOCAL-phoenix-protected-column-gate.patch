From: FIM43-Redeye <14264359+FIM43-Redeye@users.noreply.github.com>
Subject: [PATCH] LOCAL: add fixed Phoenix protected column-gate probe

Research-only instrumentation for Phoenix firmware 1.5.5.391. Expose one
fixed control/treatment operation which pauses firmware clock policy, follows
the aie-rt NPI protection sequence, gates physical column 1 for a bounded
interval, restores the clock, bounds the periodic witness to that lifecycle,
and hands policy back on every completed path. There is no generic raw mailbox
or register-access interface.

diff --git a/drivers/accel/amdxdna/aie2_message.c b/drivers/accel/amdxdna/aie2_message.c
index 715819f..c135cdc 100644
--- a/drivers/accel/amdxdna/aie2_message.c
+++ b/drivers/accel/amdxdna/aie2_message.c
@@ -11,6 +11,7 @@
 #include <drm/drm_print.h>
 #include <drm/gpu_scheduler.h>
 #include <linux/bitfield.h>
+#include <linux/delay.h>
 #include <linux/errno.h>
 #include <linux/ktime.h>
 #include <linux/pci.h>
@@ -1421,57 +1422,427 @@ int aie2_get_aie_coredump(struct amdxdna_hwctx *hwctx,
+#include "xaie_events_aieml.h"
+#include "xaiemlgbl_params.h"
+
 /*
  * Phoenix 1.5.5.391 predates the current context-relative AIE_RW_ACCESS
  * layout. Its signed firmware consumes physical row/column bytes here.
- * Keep this private research probe fixed to one read-only NPI register.
+ * Keep these private research operations fixed to the pinned register set.
  */
-struct phoenix_npi_lock_read_req {
+struct phoenix_legacy_reg_access_req {
 	u32	type;
 	u8	row;
 	u8	col;
 	u16	reserved;
 	u32	aie_offset;
-	u32	unused[3];
+	u32	write_value;
+	u32	unused[2];
 } __packed;
 
-struct phoenix_npi_lock_read_resp {
+struct phoenix_legacy_reg_access_resp {
 	enum aie2_msg_status	status;
 	u32			value;
 } __packed;
 
-static_assert(sizeof(struct phoenix_npi_lock_read_req) == 24);
-static_assert(sizeof(struct phoenix_npi_lock_read_resp) == 8);
+static_assert(sizeof(struct phoenix_legacy_reg_access_req) == 24);
+static_assert(sizeof(struct phoenix_legacy_reg_access_resp) == 8);
+
+static bool phoenix_legacy_npi_supported(struct amdxdna_dev_hdl *ndev)
+{
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+
+	return xdna->dev_info == &dev_npu1_info &&
+		xdna->fw_ver.major == 1 && xdna->fw_ver.minor == 5 &&
+		xdna->fw_ver.patch == 5 && xdna->fw_ver.build == 391 &&
+		ndev->aie.mgmt_prot_major == 5 && ndev->aie.mgmt_prot_minor == 8;
+}
+
+static int phoenix_legacy_reg_access(struct amdxdna_dev_hdl *ndev,
+				     bool write, u8 row, u8 col,
+				     u32 offset, u32 *value)
+{
+	DECLARE_AIE_MSG(phoenix_legacy_reg_access, MSG_OP_AIE_RW_ACCESS);
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+	int ret;
+
+	if (!value)
+		return -EINVAL;
+
+	req.type = write ? AIE2_ACCESS_TYPE_REG_WRITE : AIE2_ACCESS_TYPE_REG_READ;
+	req.row = row;
+	req.col = col;
+	req.aie_offset = offset;
+	if (write)
+		req.write_value = *value;
+
+	ret = aie_send_mgmt_msg_wait(&ndev->aie, &msg);
+	if (ret) {
+		XDNA_ERR(xdna, "Phoenix legacy register %s failed at 0x%08x, ret %d",
+			 write ? "write" : "read", offset, ret);
+		return ret;
+	}
+
+	if (!write)
+		*value = resp.value;
+	return 0;
+}
 
 int aie2_phoenix_read_npi_lock(struct amdxdna_dev_hdl *ndev, u32 *value)
 {
-	DECLARE_AIE_MSG(phoenix_npi_lock_read, MSG_OP_AIE_RW_ACCESS);
 	struct amdxdna_dev *xdna = ndev->aie.xdna;
