+static int phoenix_set_column_protection(struct amdxdna_dev_hdl *ndev,
+					 bool enable)
+{
+	u32 expected, value = 0xf9e8d7c6;
+	int ret, lock_ret;
+
+	ret = phoenix_legacy_reg_access(ndev, true, 0, 0, 0x1000000c,
+					&value);
+	if (!ret) {
+		value = 0;
+		ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						0x1000000c, &value);
+	}
+	if (!ret) {
+		expected = enable ? 0x00000103 : 0x00000102;
+		value = expected;
+		ret = phoenix_legacy_reg_access(ndev, true, 0, 0,
+						0x10000200, &value);
+	}
+	if (!ret) {
+		value = 0;
+		ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						0x10000200, &value);
+		if (!ret && value != expected)
+			ret = -EIO;
+	}
+
+	value = 0;
+	lock_ret = phoenix_legacy_reg_access(ndev, true, 0, 0,
+					     0x1000000c, &value);
+	if (!lock_ret) {
+		value = 0;
+		lock_ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						     0x1000000c, &value);
+	}
+	return ret ? ret : lock_ret;
+}
+
+static int phoenix_set_column_clock(struct amdxdna_dev_hdl *ndev, bool enable,
+				    bool require_enabled)
+{
+	u32 expected, value = 0;
+	int ret, close_ret;
+
+	ret = phoenix_set_column_protection(ndev, true);
+	if (ret)
+		goto close_protection;
+
+	ret = phoenix_legacy_reg_access(ndev, false, 0, 1, 0x000fff20,
+					&value);
+	if (ret)
+		goto close_protection;
+	if (require_enabled && !(value & BIT(0))) {
+		ret = -EIO;
+		goto close_protection;
+	}
+
+	expected = (value & ~BIT(0)) | enable;
+	value = expected;
+	ret = phoenix_legacy_reg_access(ndev, true, 0, 1, 0x000fff20,
+					&value);
+	if (ret)
+		goto close_protection;
+
+	value = 0;
+	ret = phoenix_legacy_reg_access(ndev, false, 0, 1, 0x000fff20,
+					&value);
+	if (!ret && value != expected)
+		ret = -EIO;
+
+close_protection:
+	close_ret = phoenix_set_column_protection(ndev, false);
+	return ret ? ret : close_ret;
+}
+
+#define PHOENIX_GATE_WITNESS_EVENT_VALUE 64U
+
+static int phoenix_gate_witness_period(struct amdxdna_dev_hdl *ndev,
+				       u32 *period)
+{
+	u32 core_threshold = 0, shim_threshold = 0;
+	int ret;
+
+	ret = phoenix_legacy_reg_access(
+		ndev, false, 2, 1,
+		XAIEMLGBL_CORE_MODULE_PERFORMANCE_COUNTER3_EVENT_VALUE,
+		&core_threshold);
+	if (ret)
+		return ret;
+	ret = phoenix_legacy_reg_access(
+		ndev, false, 0, 1,
+		XAIEMLGBL_PL_MODULE_PERFORMANCE_COUNTER0_EVENT_VALUE,
+		&shim_threshold);
+	if (ret)
+		return ret;
+	if (core_threshold != PHOENIX_GATE_WITNESS_EVENT_VALUE ||
+	    shim_threshold != core_threshold)
+		return -EINVAL;
+
+	*period = core_threshold + 1;
+	return 0;
+}
+
+static int phoenix_wait_timer_cycles(struct amdxdna_dev_hdl *ndev, u8 row,
+				     u32 timer_offset, u32 cycles)
+{
+	ktime_t deadline = ktime_add_ms(ktime_get(), 1000);
+	u32 start = 0, timer_now = 0;
+	int ret;
+
+	ret = phoenix_legacy_reg_access(ndev, false, row, 1, timer_offset,
+					&start);
+	if (ret)
+		return ret;
+	do {
+		ret = phoenix_legacy_reg_access(ndev, false, row, 1,
+						timer_offset, &timer_now);
+		if (ret)
+			return ret;
+		if (timer_now - start >= cycles)
+			return 0;
+		usleep_range(50, 100);
+	} while (ktime_before(ktime_get(), deadline));
+
+	return -ETIMEDOUT;
+}
+
+struct phoenix_column_gate_witness {
+	u32 core_before;
+	u32 shim_before;
+	u32 core_restored;
+	u32 shim_restored;
+	u32 core_stopped;
+	u32 shim_stopped;
+	u32 trace_before_core;
+	u32 trace_before_shim;
+	u32 trace_restored_core;
+	u32 trace_restored_shim;
+	u32 trace_stopped_core;
+	u32 trace_stopped_shim;
+};
+
+static int phoenix_capture_column_gate_snapshot(
+	struct amdxdna_dev_hdl *ndev, bool reverse_timers,
+	u32 *core_timer, u32 *shim_timer, u32 *core_trace, u32 *shim_trace)
+{
+	int ret;
+
+	/*
+	 * Opposite timer-read order makes the control intervals nested: core
+	 * begins first and ends last. A treatment-only inversion therefore
+	 * cannot be an artifact of the serialized management reads.
+	 */
+	if (reverse_timers) {
+		ret = phoenix_legacy_reg_access(
+			ndev, false, 0, 1, XAIEMLGBL_PL_MODULE_TIMER_LOW,
+			shim_timer);
+		if (!ret)
+			ret = phoenix_legacy_reg_access(
+				ndev, false, 2, 1, XAIEMLGBL_CORE_MODULE_TIMER_LOW,
+				core_timer);
+	} else {
+		ret = phoenix_legacy_reg_access(
+			ndev, false, 2, 1, XAIEMLGBL_CORE_MODULE_TIMER_LOW,
+			core_timer);
+		if (!ret)
+			ret = phoenix_legacy_reg_access(
+				ndev, false, 0, 1, XAIEMLGBL_PL_MODULE_TIMER_LOW,
+				shim_timer);
+	}
+	if (ret)
+		return ret;
+
+	ret = phoenix_legacy_reg_access(
+		ndev, false, 2, 1, XAIEMLGBL_CORE_MODULE_TRACE_STATUS,
+		core_trace);
+	if (ret)
+		return ret;
+	return phoenix_legacy_reg_access(
+		ndev, false, 0, 1, XAIEMLGBL_PL_MODULE_TRACE_STATUS,
+		shim_trace);
+}
+
+static int phoenix_finalize_column_gate_trace(
+	struct amdxdna_dev_hdl *ndev, u32 period,
+	struct phoenix_column_gate_witness *witness)
+{
+	u32 value;
+	int ret;
+
+	/*
+	 * First prove the restored core timer advances for a derived interval.
+	 * Then fire the source-local USER_EVENT_0 stop wave. It stops counter 3
+	 * and core trace before BROADCAST_14 closes the shim trace. Trace status
+	 * is evidence, not a completion poll: the AM025 state field includes a
+	 * terminal overrun state which must not be mistaken for a hung command.
+	 */
+	ret = phoenix_wait_timer_cycles(
+		ndev, 2, XAIEMLGBL_CORE_MODULE_TIMER_LOW, 3 * period);
+	if (ret)
+		return ret;
+
+	value = FIELD_PREP(
+		XAIEMLGBL_CORE_MODULE_EVENT_GENERATE_EVENT_MASK,
+		XAIEML_EVENTS_CORE_USER_EVENT_0);
+	ret = phoenix_legacy_reg_access(
+		ndev, true, 2, 1, XAIEMLGBL_CORE_MODULE_EVENT_GENERATE, &value);
+	if (ret)
+		return ret;
+
+	return phoenix_capture_column_gate_snapshot(
+		ndev, false, &witness->core_stopped, &witness->shim_stopped,
+		&witness->trace_stopped_core, &witness->trace_stopped_shim);
+}
+
+static int phoenix_validate_column_gate_context(struct amdxdna_dev_hdl *ndev)
+{
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+	struct amdxdna_client *client;
+	struct amdxdna_hwctx *hwctx;
+	unsigned long hwctx_id;
+	u32 count = 0;
+
+	if (ndev->hwctx_num != 1)
+		return -EBUSY;
+
+	amdxdna_for_each_client(xdna, client) {
+		amdxdna_for_each_hwctx(client, hwctx_id, hwctx) {
+			count++;
+			if (hwctx->start_col != 1 || hwctx->num_col != 1)
+				return -EINVAL;
+		}
+	}
+
+	return count == 1 ? 0 : -EBUSY;
+}
+
+int aie2_phoenix_column_gate(struct amdxdna_dev_hdl *ndev, bool treatment)
+{
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+	struct phoenix_column_gate_witness witness = {};
+	int ret, restore_ret = 0, trace_ret = 0, policy_ret;
+	u32 period, value;
+
+	if (!phoenix_legacy_npi_supported(ndev))
+		return -EOPNOTSUPP;
+
+	ret = phoenix_validate_column_gate_context(ndev);
+	if (ret)
+		return ret;
+
+	ret = aie2_set_runtime_cfg(ndev, 1, 0);
+	if (ret) {
+		policy_ret = aie2_set_runtime_cfg(ndev, 1, 1);
+		if (policy_ret)
+			XDNA_ERR(xdna, "Phoenix clock-policy handback also failed, ret %d",
+				 policy_ret);
+		return ret;
+	}
+
+	ret = phoenix_gate_witness_period(ndev, &period);
+	if (ret)
+		goto handback;
+	value = FIELD_PREP(
+		XAIEMLGBL_CORE_MODULE_EVENT_GENERATE_EVENT_MASK,
+		XAIEML_EVENTS_CORE_USER_EVENT_1);
+	ret = phoenix_legacy_reg_access(
+		ndev, true, 2, 1, XAIEMLGBL_CORE_MODULE_EVENT_GENERATE, &value);
+	if (ret)
+		goto handback;
+
+	ret = phoenix_wait_timer_cycles(
+		ndev, 2, XAIEMLGBL_CORE_MODULE_TIMER_LOW, 3 * period);
+	if (ret)
+		goto handback;
+	ret = phoenix_capture_column_gate_snapshot(
+		ndev, false, &witness.core_before, &witness.shim_before,
+		&witness.trace_before_core, &witness.trace_before_shim);
+	if (ret)
+		goto handback;
+
+	ret = phoenix_set_column_clock(ndev, !treatment, true);
+	if (!ret)
+		ret = phoenix_wait_timer_cycles(
+			ndev, 0, XAIEMLGBL_PL_MODULE_TIMER_LOW, 4 * period);
+
+	restore_ret = phoenix_set_column_clock(ndev, true, false);
+	if (!restore_ret) {
+		trace_ret = phoenix_capture_column_gate_snapshot(
+			ndev, true, &witness.core_restored,
+			&witness.shim_restored, &witness.trace_restored_core,
+			&witness.trace_restored_shim);
+		if (!trace_ret)
+			trace_ret = phoenix_finalize_column_gate_trace(
+				ndev, period, &witness);
+		if (!ret && !trace_ret)
+			XDNA_INFO(
+				xdna,
+				"PHOENIX_COLUMN_GATE_WITNESS arm=%s period=%u "
+				"core_before=0x%08x shim_before=0x%08x "
+				"core_restored=0x%08x shim_restored=0x%08x "
+				"core_stopped=0x%08x shim_stopped=0x%08x "
+				"trace_before_core=0x%08x trace_before_shim=0x%08x "
+				"trace_restored_core=0x%08x trace_restored_shim=0x%08x "
+				"trace_stopped_core=0x%08x trace_stopped_shim=0x%08x",
+				treatment ? "treatment" : "control", period,
+				witness.core_before, witness.shim_before,
+				witness.core_restored, witness.shim_restored,
+				witness.core_stopped, witness.shim_stopped,
+				witness.trace_before_core, witness.trace_before_shim,
+				witness.trace_restored_core,
+				witness.trace_restored_shim,
+				witness.trace_stopped_core,
+				witness.trace_stopped_shim);
+	}
+handback:
+	policy_ret = aie2_set_runtime_cfg(ndev, 1, 1);
+	if (ret)
+		XDNA_ERR(xdna, "Phoenix column-gate operation failed, ret %d", ret);
+	if (restore_ret)
+		XDNA_ERR(xdna, "Phoenix column-clock restore failed, ret %d", restore_ret);
+	if (trace_ret)
+		XDNA_ERR(xdna, "Phoenix trace finalization failed, ret %d", trace_ret);
+	if (policy_ret)
+		XDNA_ERR(xdna, "Phoenix clock-policy handback failed, ret %d", policy_ret);
+
+	if (ret)
+		return ret;
+	if (restore_ret)
+		return restore_ret;
+	if (trace_ret)
+		return trace_ret;
+	return policy_ret;
+}
+
 int aie2_rw_aie_reg(struct amdxdna_hwctx *hwctx, bool is_read,
 		    u8 row, u8 col, u32 addr, u32 *value)
 {
diff --git a/drivers/accel/amdxdna/aie2_pci.h b/drivers/accel/amdxdna/aie2_pci.h
