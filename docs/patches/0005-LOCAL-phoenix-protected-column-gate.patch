+static int phoenix_set_column_protection(struct amdxdna_dev_hdl *ndev,
+					 bool enable)
+{
+	u32 expected, value = 0xf9e8d7c6;
+	int ret, lock_ret;
+
+	ret = phoenix_legacy_reg_access(ndev, true, 0, 0, 0x1000000c,
+					&value);
+	if (!ret) {
+		value = 0;
+		ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						0x1000000c, &value);
+	}
+	if (!ret) {
+		expected = enable ? 0x00000103 : 0x00000102;
+		value = expected;
+		ret = phoenix_legacy_reg_access(ndev, true, 0, 0,
+						0x10000200, &value);
+	}
+	if (!ret) {
+		value = 0;
+		ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						0x10000200, &value);
+		if (!ret && value != expected)
+			ret = -EIO;
+	}
+
+	value = 0;
+	lock_ret = phoenix_legacy_reg_access(ndev, true, 0, 0,
+					     0x1000000c, &value);
+	if (!lock_ret) {
+		value = 0;
+		lock_ret = phoenix_legacy_reg_access(ndev, false, 0, 0,
+						     0x1000000c, &value);
+	}
+	return ret ? ret : lock_ret;
+}
+
+static int phoenix_set_column_clock(struct amdxdna_dev_hdl *ndev, bool enable,
+				    bool require_enabled)
+{
+	u32 expected, value = 0;
+	int ret, close_ret;
+
+	ret = phoenix_set_column_protection(ndev, true);
+	if (ret)
+		goto close_protection;
+
+	ret = phoenix_legacy_reg_access(ndev, false, 0, 1, 0x000fff20,
+					&value);
+	if (ret)
+		goto close_protection;
+	if (require_enabled && !(value & BIT(0))) {
+		ret = -EIO;
+		goto close_protection;
+	}
+
+	expected = (value & ~BIT(0)) | enable;
+	value = expected;
+	ret = phoenix_legacy_reg_access(ndev, true, 0, 1, 0x000fff20,
+					&value);
+	if (ret)
+		goto close_protection;
+
+	value = 0;
+	ret = phoenix_legacy_reg_access(ndev, false, 0, 1, 0x000fff20,
+					&value);
+	if (!ret && value != expected)
+		ret = -EIO;
+
+close_protection:
+	close_ret = phoenix_set_column_protection(ndev, false);
+	return ret ? ret : close_ret;
+}
+
+static int phoenix_finalize_column_gate_trace(struct amdxdna_dev_hdl *ndev)
+{
+	ktime_t deadline;
+	u32 core_state, shim_state, value;
+	int ret;
+
+	/*
+	 * The staged witness arms the toolchain-defined stops before execution
+	 * and replaces its ordinary early trigger with a NOOP. Fire that same
+	 * shim USER_EVENT_0 -> core BROADCAST_14 route only after restore.
+	 */
+	value = FIELD_PREP(
+		XAIEMLGBL_PL_MODULE_EVENT_GENERATE_EVENT_MASK,
+		XAIEML_EVENTS_PL_USER_EVENT_0);
+	ret = phoenix_legacy_reg_access(
+		ndev, true, 0, 1, XAIEMLGBL_PL_MODULE_EVENT_GENERATE, &value);
+	if (ret)
+		return ret;
+
+	deadline = ktime_add_ms(ktime_get(), 1000);
+	do {
+		core_state = 0;
+		ret = phoenix_legacy_reg_access(
+			ndev, false, 2, 1, XAIEMLGBL_CORE_MODULE_TRACE_STATUS,
+			&core_state);
+		if (ret)
+			return ret;
+		shim_state = 0;
+		ret = phoenix_legacy_reg_access(
+			ndev, false, 0, 1, XAIEMLGBL_PL_MODULE_TRACE_STATUS,
+			&shim_state);
+		if (ret)
+			return ret;
+		if (FIELD_GET(
+			    XAIEMLGBL_CORE_MODULE_TRACE_STATUS_STATE_MASK,
+			    core_state) ==
+				XAIEMLGBL_CORE_MODULE_TRACE_STATUS_STATE_DEFVAL &&
+		    FIELD_GET(
+			    XAIEMLGBL_PL_MODULE_TRACE_STATUS_STATE_MASK,
+			    shim_state) ==
+				XAIEMLGBL_PL_MODULE_TRACE_STATUS_STATE_DEFVAL)
+			return 0;
+		usleep_range(50, 100);
+	} while (ktime_before(ktime_get(), deadline));
+
+	return -ETIMEDOUT;
+}
+
+static int phoenix_validate_column_gate_context(struct amdxdna_dev_hdl *ndev)
+{
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+	struct amdxdna_client *client;
+	struct amdxdna_hwctx *hwctx;
+	unsigned long hwctx_id;
+	u32 count = 0;
+
+	if (ndev->hwctx_num != 1)
+		return -EBUSY;
+
+	amdxdna_for_each_client(xdna, client) {
+		amdxdna_for_each_hwctx(client, hwctx_id, hwctx) {
+			count++;
+			if (hwctx->start_col != 1 || hwctx->num_col != 1)
+				return -EINVAL;
+		}
+	}
+
+	return count == 1 ? 0 : -EBUSY;
+}
+
+int aie2_phoenix_column_gate(struct amdxdna_dev_hdl *ndev, bool treatment)
+{
+	struct amdxdna_dev *xdna = ndev->aie.xdna;
+	int ret, restore_ret, trace_ret = 0, policy_ret;
+
+	if (!phoenix_legacy_npi_supported(ndev))
+		return -EOPNOTSUPP;
+
+	ret = phoenix_validate_column_gate_context(ndev);
+	if (ret)
+		return ret;
+
+	ret = aie2_set_runtime_cfg(ndev, 1, 0);
+	if (ret) {
+		policy_ret = aie2_set_runtime_cfg(ndev, 1, 1);
+		if (policy_ret)
+			XDNA_ERR(xdna, "Phoenix clock-policy handback also failed, ret %d",
+				 policy_ret);
+		return ret;
+	}
+
+	usleep_range(100, 150);
+
+	ret = phoenix_set_column_clock(ndev, !treatment, true);
+	if (!ret)
+		usleep_range(100, 150);
+
+	restore_ret = phoenix_set_column_clock(ndev, true, false);
+	if (!restore_ret) {
+		usleep_range(100, 150);
+		trace_ret = phoenix_finalize_column_gate_trace(ndev);
+	}
+	policy_ret = aie2_set_runtime_cfg(ndev, 1, 1);
+	if (ret)
+		XDNA_ERR(xdna, "Phoenix column-gate transition failed, ret %d", ret);
+	if (restore_ret)
+		XDNA_ERR(xdna, "Phoenix column-clock restore failed, ret %d", restore_ret);
+	if (trace_ret)
+		XDNA_ERR(xdna, "Phoenix trace finalization failed, ret %d", trace_ret);
+	if (policy_ret)
+		XDNA_ERR(xdna, "Phoenix clock-policy handback failed, ret %d", policy_ret);
+
+	if (ret)
+		return ret;
+	if (restore_ret)
+		return restore_ret;
+	if (trace_ret)
+		return trace_ret;
+	return policy_ret;
+}
+
 int aie2_rw_aie_reg(struct amdxdna_hwctx *hwctx, bool is_read,
 		    u8 row, u8 col, u32 addr, u32 *value)
 {
diff --git a/drivers/accel/amdxdna/aie2_pci.h b/drivers/accel/amdxdna/aie2_pci.h
index c42e6a7..35ffd48 100644
--- a/drivers/accel/amdxdna/aie2_pci.h
+++ b/drivers/accel/amdxdna/aie2_pci.h
@@ -266,6 +266,7 @@ int aie2_get_aie_coredump(struct amdxdna_hwctx *hwctx,
 			  struct amdxdna_msg_buf_hdl *list_hdl,
 			  u32 num_bufs);
 int aie2_phoenix_read_npi_lock(struct amdxdna_dev_hdl *ndev, u32 *value);
+int aie2_phoenix_column_gate(struct amdxdna_dev_hdl *ndev, bool treatment);
 int aie2_rw_aie_reg(struct amdxdna_hwctx *hwctx, bool is_read,
 		    u8 row, u8 col, u32 addr, u32 *value);
 int aie2_rw_aie_mem(struct amdxdna_hwctx *hwctx, bool is_read,
diff --git a/drivers/accel/amdxdna/amdxdna_debugfs.c b/drivers/accel/amdxdna/amdxdna_debugfs.c
index 6780549..e183bc8 100644
--- a/drivers/accel/amdxdna/amdxdna_debugfs.c
+++ b/drivers/accel/amdxdna/amdxdna_debugfs.c
@@ -127,6 +127,48 @@ static int amdxdna_phoenix_npi_lock_show(struct seq_file *m, void *unused)
 
 AMDXDNA_DBGFS_FOPS(phoenix_npi_lock, amdxdna_phoenix_npi_lock_show, NULL);
 
+static ssize_t amdxdna_phoenix_column_gate_write(struct file *file,
+						 const char __user *buf,
+						 size_t count, loff_t *ppos)
+{
+	struct amdxdna_dev *xdna = file_to_xdna(file);
+	char kbuf[16];
+	bool treatment;
+	int ret;
+
+	if (!count || count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, buf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+
+	if (sysfs_streq(kbuf, "control"))
+		treatment = false;
+	else if (sysfs_streq(kbuf, "treatment"))
+		treatment = true;
+	else
+		return -EINVAL;
+
+	ret = amdxdna_pm_resume_get(xdna);
+	if (ret)
+		return ret;
+
+	mutex_lock(&xdna->dev_lock);
+	ret = aie2_phoenix_column_gate(xdna->dev_handle, treatment);
+	mutex_unlock(&xdna->dev_lock);
+	amdxdna_pm_suspend_put(xdna);
+
+	return ret ? ret : count;
+}
+
+static int amdxdna_phoenix_column_gate_show(struct seq_file *m, void *unused)
+{
+	return -EACCES;
+}
+
+AMDXDNA_DBGFS_FOPS(phoenix_column_gate, amdxdna_phoenix_column_gate_show,
+			  amdxdna_phoenix_column_gate_write);
+
 static const struct {
 	const char *name;
 	const struct file_operations *fops;
@@ -134,6 +176,7 @@ static const struct {
 } amdxdna_dbgfs_files[] = {
 	AMDXDNA_DBGFS_FILE(carveout, 0600),
 	AMDXDNA_DBGFS_FILE(phoenix_npi_lock, 0400),
+	AMDXDNA_DBGFS_FILE(phoenix_column_gate, 0200),
 };
 
